{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"],
        "enabled": true
      }
    }
    // Figma MCP вынесен в глобальный конфиг ~/.config/opencode/opencode.jsonc
    // (токен не должен лежать в git-репозитории)
  },
  // Автономная работа: минимум запросов подтверждения.
  // Последнее совпадающее правило выигрывает.
  "permissions": [
    // автономный режим: всё разрешено, важное перекрыто deny-правилами ниже
    { "action": "*", "resource": "*", "effect": "allow" },
    // MCP-серверы: figma и playwright — явно
    { "action": "figma_*", "resource": "*", "effect": "allow" },
    { "action": "playwright_*", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "allow" },
    { "action": "read", "resource": "*.env.*", "effect": "allow" },
    {
      "action": "external_directory",
      "resource": "/private/var/folders/*",
      "effect": "allow"
    },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    {
      "action": "external_directory",
      "resource": "/private/tmp/*",
      "effect": "allow"
    },
    { "action": "external_directory", "resource": "~/*", "effect": "allow" },
    { "action": "read", "resource": "~/*", "effect": "allow" },
    { "action": "edit", "resource": "~/*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    // автономный режим: агент не задаёт вопросов, решает сам
    { "action": "question", "resource": "*", "effect": "deny" },
    // страховки от необратимых действий
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~/*", "effect": "deny" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push -f*", "effect": "deny" }
  ],
  "commands": {
    "goal": {
      "description": "Долгая автономная задача на часы",
      "agent": "build",
      "template": "Выполняй следующую задачу полностью автономно, не задавая вопросов. Главное: следуй циклу из docs/tasks/MASTER.md (подготовка → имплементация → локальная проверка → коммит/пайплайн → прод-верификация → статусы). Контекст: README.md, ARCHITECTURE.md, docs/. Задачи и статусы: docs/tasks/. Контракты: https://eclipse-sim.ru/api/docs и docs/backend/spec-*.md. Правила: тикет = коммит со обновлением статусов (файл тикета, README-индекс, docs/common/status.md); перед сдачей — go build/vet/gofmt и npm build/lint; комментарии в коде не писать. Задача: $ARGUMENTS. Работай до полного завершения по циклу, в конце дай отчёт: что сделано, что проверено (таблица кейс → результат), что осталось."
    }
  }
}
